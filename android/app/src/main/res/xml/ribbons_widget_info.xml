<?xml version="1.0" encoding="utf-8"?>
<!-- No periodic update: ribbon data only changes inside the app, which
     pushes a fresh payload (and an update broadcast) on every change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_ribbons_description"
    android:initialLayout="@layout/widget_ribbons"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_ribbons"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
