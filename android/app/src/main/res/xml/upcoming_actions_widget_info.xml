<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis (1h) keeps the overdue coloring roughly current while
     the app is closed; data itself is pushed by the app on every change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_actions_description"
    android:initialLayout="@layout/widget_upcoming_actions"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_upcoming_actions"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
