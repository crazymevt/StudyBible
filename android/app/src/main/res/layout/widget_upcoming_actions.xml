<?xml version="1.0" encoding="utf-8"?>
<!-- Five fixed row slots (see UpcomingActionsWidgetProvider); unused rows are
     set GONE at render time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/actions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_actions_label"
        android:textColor="@color/widget_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/actions_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_actions_empty"
        android:textColor="@color/widget_subtitle"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/action_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/action_title_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_due_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/action_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_due_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/action_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_due_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/action_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_due_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/action_title_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_due_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
