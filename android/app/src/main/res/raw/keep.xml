<?xml version="1.0" encoding="utf-8"?>
<!-- flutter_local_notifications resolves its small icon at runtime via
     Resources.getIdentifier("notification_icon", "drawable", ...) rather
     than a static @drawable/ reference, so R8's resource shrinker (on by
     default for release builds) can't see it's used and strips it —
     release builds then throw PlatformException(invalid_icon) even though
     the exact same code works in an unshrunk debug build. This tells the
     shrinker to keep it regardless. See
     https://developer.android.com/build/shrink-code#keep-resources -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/notification_icon" />
